ui = true

cluster_name = "{{ vault_cluster_name }}"

storage "raft" {
  path    = "{{ vault_data_dir }}"
  node_id = "{{ inventory_hostname }}"
}

listener "tcp" {
  address     = "{{ vault_listener_address }}"
  tls_disable = {{ 1 if vault_tls_disable else 0 }}
}

api_addr     = "{{ 'http' if vault_tls_disable else 'https' }}://{{ vault_api_address | default(ansible_host | default(ansible_default_ipv4.address)) }}:8200"
cluster_addr = "{{ 'http' if vault_tls_disable else 'https' }}://{{ vault_cluster_address | default(ansible_host | default(ansible_default_ipv4.address)) }}:8201"
