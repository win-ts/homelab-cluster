---
services:
  redis:
    image: "{{ redis_image }}"
    container_name: redis
    restart: unless-stopped

    ports:
      - "6379:6379"

    volumes:
      - "{{ redis_data_dir }}:/data"

    command:
      - redis-server
      - --appendonly
      - "yes"
      - --requirepass
      - "{{ redis_password }}"

    healthcheck:
      test:
        - CMD
        - redis-cli
        - -a
        - "{{ redis_password }}"
        - ping
      interval: 10s
      timeout: 5s
      retries: 5
